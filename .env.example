# Public browser configuration only. Never put service_role or secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Keep static until database setup/import/auth/RLS checks have passed.
VITE_CATALOG_SOURCE=static
# HTTPS production origin only, e.g. your verified Vercel project domain.
# Leave empty until deployment; /qr will not generate a Codespaces/preview QR.
VITE_SITE_URL=
