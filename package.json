{
  "name": "fretline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "vite",
    "dev:pacifica-preview": "vite --mode pacifica-preview",
    "dev:yamaha-preview": "vite --mode yamaha-preview",
    "build": "vite build",
    "build:vercel": "node scripts/check-deployment.mjs && vite build",
    "deploy:check": "node scripts/check-deployment.mjs",
    "deploy:check-data": "node scripts/check-live-catalog.mjs --initial",
    "deploy:test": "node scripts/test-deployment.mjs",
    "preview": "vite preview",
    "images:check": "node scripts/check-images.mjs",
    "practice:check": "node scripts/check-practice.mjs",
    "catalog:check": "node scripts/validate-catalog.mjs",
    "catalog:import": "node scripts/import-csv.mjs",
    "admin:seed": "node scripts/build-admin-seed.mjs",
    "admin:check": "node scripts/check-admin.mjs",
    "phase4:check": "node scripts/check-phase4.mjs",
    "phase5:check": "node scripts/check-phase5.mjs",
    "phase6:check": "node scripts/check-phase6.mjs",
    "phase7:check": "node scripts/check-phase7.mjs",
    "phase8:check": "node scripts/check-phase8.mjs && node scripts/check-phase8-catalog.mjs",
    "phase9:check": "node scripts/check-phase9.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  }
}
